# Synapse Agent — Railway deployment environment example
# ======================================================
# Copy the values you need into Railway as Service Variables.
# (Railway > your service > Variables, or set them in railway.toml.)
#
# The dashboard binds 0.0.0.0:9119 and its auth gate REQUIRES an auth
# provider on non-loopback binds. Pick ONE of the two options below,
# otherwise the dashboard fails closed and Railway healthchecks fail.

# --- Enable the web dashboard (required for a Railway URL) ---
SYNAPSE_DASHBOARD=1
SYNAPSE_DASHBOARD_HOST=0.0.0.0
SYNAPSE_DASHBOARD_PORT=9119

# --- OPTION A: Basic Auth (simplest, zero external IDP) ---
# SYNAPSE_DASHBOARD_BASIC_AUTH_USERNAME=admin
# SYNAPSE_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password
# SYNAPSE_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_random_session_secret

# --- OPTION B: OAuth / OIDC (uses the bundled provider) ---
# SYNAPSE_DASHBOARD_OAUTH_CLIENT_ID=CHANGE_ME
# SYNAPSE_DASHBOARD_OIDC_ISSUER=https://your-idp.example.com
# SYNAPSE_DASHBOARD_OIDC_CLIENT_ID=CHANGE_ME
# SYNAPSE_DASHBOARD_OIDC_CLIENT_SECRET=CHANGE_ME

# --- Filesystem / data root ---
# The container writes agent state under $SYNAPSE_HOME. On Railway attach
# a volume mounted at /opt/data (or set a custom path) so state persists
# across redeploys.
SYNAPSE_HOME=/opt/data

# --- Model / provider keys (add as needed) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# etc. — see .env.example for the full matrix.
